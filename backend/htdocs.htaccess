RewriteEngine on

# CORS-Headers für HTTPS
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Upgrade, Connection, Sec-WebSocket-Key, Sec-WebSocket-Version, Sec-WebSocket-Protocol"
Header always set Access-Control-Allow-Credentials "true"

# API-Requests zu Node.js-Proxy weiterleiten
RewriteRule ^api/(.*) http://localhost:8080/api/$1 [P,L]

# WebSocket-Requests zu Node.js-Proxy weiterleiten
RewriteRule ^ws/(.*) http://localhost:8080/ws/$1 [P,L]

# Basic Auth für alle Seiten außer APIs und App-Seite
<FilesMatch "^(?!.*(api|ws|app)).*$">
    AuthType Basic
    AuthName "Geschützter Bereich"
    AuthUserFile /pages/d0/aa/d0017222/home/.htpasswd
    Require valid-user
</FilesMatch>

# Ausnahmen für API-Endpunkte
<FilesMatch "^(api|ws)">
    Satisfy Any
    Allow from all
</FilesMatch>

# Ausnahme für App-Seite (falls vorhanden)
<FilesMatch "app">
    Satisfy Any
    Allow from all
</FilesMatch> 