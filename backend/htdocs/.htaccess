RewriteEngine On

# CORS (optional; falls benötigt)
Header always set Access-Control-Allow-Origin "https://iqmedix.cloud"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Upgrade, Connection, Sec-WebSocket-Key, Sec-WebSocket-Version, Sec-WebSocket-Protocol, Origin"
Header always set Access-Control-Allow-Credentials "true"

# MIME Types für Flutter Web
AddType application/javascript .js
AddType application/javascript .mjs
AddType application/wasm .wasm

# Security Headers
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Content-Security-Policy "default-src 'self' https://*.gstatic.com https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://*.gstatic.com https://fonts.googleapis.com; img-src 'self' data: https://*.gstatic.com; font-src 'self' https://*.gstatic.com https://fonts.googleapis.com data:; connect-src 'self' wss: https://*.gstatic.com; object-src 'none'; base-uri 'self'; frame-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self';"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

# OPTIONS Preflight direkt beantworten
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=200,L]

# WebSocket-Upgrade über wstunnel an Node-Proxy (WICHTIG: ws:// und Upgrade-Bedingungen)
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^ws/(.*)$ ws://127.0.0.1:8080/ws/$1 [P,L]

# API an Node-Proxy
RewriteRule ^api/(.*)$ http://127.0.0.1:8080/api/$1 [P,L]

# Statische Dateien direkt ausliefern
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Flutter Web SPA-Fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]


